<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="general.settings"
        android:title="@string/preferences_general_title"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="storage.use.collection.browser"
            android:title="@string/preferences_general_use_collection_browser_title"
            android:summary="@string/preferences_general_use_collection_browser_summary"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="appearance.settings"
        android:title="@string/preferences_appearance_title"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="view.ui.scale"
            android:title="@string/preferences_ui_scale_title"
            android:entries="@array/tg_scale_entries"
            android:entryValues="@array/tg_scale_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="view.score.scale"
            android:title="@string/preferences_score_scale_title"
            android:entries="@array/tg_scale_entries"
            android:entryValues="@array/tg_scale_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="view.measure.split"
            android:title="@string/preferences_measure_split_title"
            android:entries="@array/tg_split_entries"
            android:entryValues="@array/tg_split_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="view.smooth.cursor"
            android:title="@string/preferences_smooth_cursor_title"
            android:summary="@string/preferences_smooth_cursor_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="view.settings"
        android:title="@string/preferences_view_category_title"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="view.show.score"
            android:title="@string/action_view_layout_show_score"
            android:persistent="false"
            app:iconSpaceReserved="false"/>

        <CheckBoxPreference
            android:key="view.show.multitrack"
            android:title="@string/action_view_layout_show_multitrack"
            android:persistent="false"
            app:iconSpaceReserved="false"/>

        <CheckBoxPreference
            android:key="view.show.chord.name"
            android:title="@string/action_view_layout_show_chord_name"
            android:persistent="false"
            app:iconSpaceReserved="false"/>

        <CheckBoxPreference
            android:key="view.show.chord.diagram"
            android:title="@string/action_view_layout_show_chord_diagram"
            android:persistent="false"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="sound.settings"
        android:title="@string/preferences_sound_category_title"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="midi.output.port"
            android:title="@string/preferences_midi_output_port_title"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>
