<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#ffffff">

	<FrameLayout
		android:id="@+id/main_body"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<include layout="@layout/view_tablature" />
	</FrameLayout>

	<FrameLayout
		android:id="@+id/main_top"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_gravity="top"/>

	<FrameLayout
		android:id="@+id/main_left"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_gravity="start"/>

	<FrameLayout
		android:id="@+id/main_right"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_gravity="end"/>

	<!-- Floating top buttons (the top bar is hidden on this screen) -->
	<ImageButton
		android:id="@+id/main_menu_button"
		android:layout_width="44dp"
		android:layout_height="44dp"
		android:layout_gravity="top|start"
		android:layout_marginLeft="12dp"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_float_button"
		android:contentDescription="@string/main_drawer_file"
		android:elevation="3dp"
		android:padding="11dp"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_tile_menu"
		android:tint="?attr/colorOnSurface"/>

	<ImageButton
		android:id="@+id/main_settings_button"
		android:layout_width="44dp"
		android:layout_height="44dp"
		android:layout_gravity="top|end"
		android:layout_marginRight="12dp"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_float_button"
		android:contentDescription="@string/action_menu_settings"
		android:elevation="3dp"
		android:padding="11dp"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_settings_cookie"
		android:tint="?attr/colorOnSurface"/>

	<include
		android:id="@+id/main_bottom"
		layout="@layout/view_quick_sheet"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
		app:behavior_hideable="false"
		app:behavior_peekHeight="72dp"
		app:gestureInsetBottomIgnored="true"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
