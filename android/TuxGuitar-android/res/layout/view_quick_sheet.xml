				android:src="@drawable/ic_transpose_white_24dp"
				style="@style/TGQuickSheetTileIcon"/>

			<TextView
				android:text="@string/quick_sheet_tile_transpose"
				style="@style/TGQuickSheetTileLabel"/>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/quick_sheet_keyboard"
			android:contentDescription="@string/action_tab_keyboard_toggle"
			style="@style/TGQuickSheetTile">

			<ImageView
				android:src="@drawable/ic_edit_white_24dp"
				style="@style/TGQuickSheetTileIcon"/>

			<TextView
				android:text="@string/quick_sheet_edit"
				style="@style/TGQuickSheetTileLabel"/>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/quick_sheet_more_toggle"
			android:contentDescription="@string/quick_sheet_more"
			style="@style/TGQuickSheetTile">

			<ImageView
				android:src="@drawable/ic_more_white_24dp"
				style="@style/TGQuickSheetTileIcon"/>

			<TextView
				android:text="@string/quick_sheet_more"
				style="@style/TGQuickSheetTileLabel"/>
		</LinearLayout>
	</LinearLayout>
