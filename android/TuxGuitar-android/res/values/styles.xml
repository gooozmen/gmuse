<resources xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Overridable theme. -->
	<style name="AppBaseTheme" parent="Theme.Material3.DayNight.NoActionBar"/>
	<style name="AppBaseWidget.Spinner" parent="Widget.AppCompat.Spinner.Underlined"/>

	<!-- Application theme. -->
	<style name="TGTheme" parent="AppBaseTheme">
		<!-- ========================================================= -->
		<!-- ==== COLOR ============================================== -->
		<!-- ========================================================= -->
		<!-- Material You colour roles: fallback palette, overridden by the
		     wallpaper-derived palette on Android 12+ (see TGApplication). -->
		<item name="colorPrimary">@color/md_primary</item>
		<item name="colorOnPrimary">@color/md_on_primary</item>
		<item name="colorPrimaryContainer">@color/md_primary_container</item>
		<item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
		<item name="colorPrimaryInverse">@color/md_primary_inverse</item>
		<item name="colorSecondary">@color/md_secondary</item>
		<item name="colorOnSecondary">@color/md_on_secondary</item>
		<item name="colorSecondaryContainer">@color/md_secondary_container</item>
		<item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
		<item name="colorTertiary">@color/md_tertiary</item>
		<item name="colorOnTertiary">@color/md_on_tertiary</item>
		<item name="colorTertiaryContainer">@color/md_tertiary_container</item>
		<item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
		<item name="colorError">@color/md_error</item>
		<item name="colorOnError">@color/md_on_error</item>
		<item name="colorErrorContainer">@color/md_error_container</item>
		<item name="colorOnErrorContainer">@color/md_on_error_container</item>
		<item name="android:colorBackground">@color/md_surface</item>
		<item name="colorOnBackground">@color/md_on_surface</item>
		<item name="colorSurface">@color/md_surface</item>
		<item name="colorOnSurface">@color/md_on_surface</item>
		<item name="colorSurfaceVariant">@color/md_surface_variant</item>
		<item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
		<item name="colorOutline">@color/md_outline</item>
		<item name="colorOutlineVariant">@color/md_outline_variant</item>
		<item name="colorSurfaceInverse">@color/md_surface_inverse</item>
		<item name="colorOnSurfaceInverse">@color/md_on_surface_inverse</item>
		<item name="colorSurfaceDim">@color/md_surface_dim</item>
		<item name="colorSurfaceBright">@color/md_surface_bright</item>
		<item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
		<item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
		<item name="colorSurfaceContainer">@color/md_surface_container</item>
		<item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
		<item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

		<!-- Legacy five-step grey ramp, mapped onto the tonal surfaces. -->
		<item name="darkestColor">?attr/colorSurface</item>
		<item name="darkColor">?attr/colorSurfaceContainerLow</item>
		<item name="mediumColor">?attr/colorSurfaceContainerHigh</item>
		<item name="lightColor">?attr/colorOutlineVariant</item>
		<item name="lightestColor">?attr/colorOnSurface</item>

		<!-- ========================================================= -->
		<!-- ==== COLOR SELECTOR ===================================== -->
		<!-- ========================================================= -->
		<item name="textLightColorSelector">@color/color_text_light</item>

		<!-- ========================================================= -->
		<!-- ==== CUSTOM STYLES ====================================== -->
		<!-- ========================================================= -->
		<item name="dialogStyle">@style/dialogStyle</item>
		<item name="dialogVerticalSpacerStyle">@style/dialogVerticalSpacerStyle</item>
		<item name="dialogImageButtonStyle">@style/dialogImageButtonStyle</item>
		<item name="dialogImageButtonSettingsStyle">@style/TGImageButton.Settings</item>

		<item name="mainImageButtonStyle">@style/mainImageButtonStyle</item>
		<item name="mainImageButtonPlayStyle">@style/TGImageButton.Play</item>
		<item name="mainImageButtonStopStyle">@style/TGImageButton.Stop</item>

		<item name="mainFloatingButtonAddStyle">@style/TGFloatingButton.Add</item>

		<item name="tabKeyBoardStyle">@style/tabKeyBoardStyle</item>
		<item name="tabKeyBoardImageButtonKey0Style">@style/TGKeyBoardButton.Key0</item>
		<item name="tabKeyBoardImageButtonKey1Style">@style/TGKeyBoardButton.Key1</item>
		<item name="tabKeyBoardImageButtonKey2Style">@style/TGKeyBoardButton.Key2</item>
		<item name="tabKeyBoardImageButtonKey3Style">@style/TGKeyBoardButton.Key3</item>
		<item name="tabKeyBoardImageButtonKey4Style">@style/TGKeyBoardButton.Key4</item>
		<item name="tabKeyBoardImageButtonKey5Style">@style/TGKeyBoardButton.Key5</item>
		<item name="tabKeyBoardImageButtonKey6Style">@style/TGKeyBoardButton.Key6</item>
		<item name="tabKeyBoardImageButtonKey7Style">@style/TGKeyBoardButton.Key7</item>
		<item name="tabKeyBoardImageButtonKey8Style">@style/TGKeyBoardButton.Key8</item>
		<item name="tabKeyBoardImageButtonKey9Style">@style/TGKeyBoardButton.Key9</item>
		<item name="tabKeyBoardImageButtonInsertStyle">@style/TGKeyBoardButton.Insert</item>
		<item name="tabKeyBoardImageButtonDeleteStyle">@style/TGKeyBoardButton.Delete</item>
		<item name="tabKeyBoardImageButtonDurationStyle">@style/TGKeyBoardButton.Duration</item>
		<item name="tabKeyBoardImageButtonDurationIncrementStyle">@style/TGKeyBoardButton.DurationIncrement</item>
		<item name="tabKeyBoardImageButtonDurationDecrementStyle">@style/TGKeyBoardButton.DurationDecrement</item>
		<item name="tabKeyBoardImageButtonRightStyle">@style/TGKeyBoardButton.Right</item>
		<item name="tabKeyBoardImageButtonLeftStyle">@style/TGKeyBoardButton.Left</item>
		<item name="tabKeyBoardImageButtonUpStyle">@style/TGKeyBoardButton.Up</item>
		<item name="tabKeyBoardImageButtonDownStyle">@style/TGKeyBoardButton.Down</item>
		<item name="tabKeyBoardImageButtonSelectStyle">@style/TGKeyBoardButton.Select</item>

		<item name="mainDrawerStyle">@style/mainDrawerStyle</item>
		<item name="mainDrawerListItemStyle">@style/mainDrawerListItemStyle</item>
		<item name="mainDrawerImageButtonMixerStyle">@style/TGImageButton.Mixer</item>
		<item name="mainDrawerImageButtonInfoStyle">@style/TGImageButton.Info</item>
		<item name="mainDrawerFloatingButtonAddTrackStyle">?attr/mainFloatingButtonAddStyle</item>
		<item name="mainDrawerToolbarStyle">@style/mainDrawerToolbarStyle</item>
		<item name="mainDrawerTransportPanelStyle">@style/mainDrawerTransportPanelStyle</item>

		<item name="browserSaveImageButtonStyle">@style/TGImageButton.Save</item>

		<item name="browserElementIconStyle">@style/browserElementIconStyle</item>
		<item name="browserElementIconFileStyle">@style/browserElementIconFileStyle</item>
		<item name="browserElementIconFolderStyle">@style/browserElementIconFolderStyle</item>
		<item name="browserElementNameStyle">@style/browserElementNameStyle</item>
		<item name="browserCollectionsDlgImageButtonAddStyle">@style/TGImageButton.Add</item>
		<item name="browserCollectionsDlgImageButtonDeleteStyle">@style/TGImageButton.Delete</item>

		<item name="channelListStyle">@style/channelListStyle</item>
		<item name="channelListItemStyle">@style/channelListItemStyle</item>
		<item name="channelListItemTextViewStyle">@style/channelListItemTextViewStyle</item>
		<item name="channelListItemImageButtonStyle">@style/channelListItemImageButtonStyle</item>
		<item name="channelListItemDividerStyle">@style/channelListItemDividerStyle</item>

		<!-- ========================================================= -->
		<!-- ==== OVERRIDE WIDGET STYLES ============================= -->
		<!-- ========================================================= -->
		<item name="android:textViewStyle">@style/TGWidget.TextView</item>

		<!-- Top bar: its own tone, running up under the status bar -->
		<item name="actionBarStyle">@style/TGWidget.ActionBar</item>
		<item name="actionButtonStyle">@style/TGWidget.ActionButton</item>
		<item name="toolbarNavigationButtonStyle">@style/TGWidget.NavigationButton</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">@bool/tg_light_system_bars</item>
		<item name="android:spinnerStyle">@style/TGWidget.Spinner</item>
		<item name="android:seekBarStyle">@style/TGWidget.SeekBar</item>
		<item name="seekBarStyle">@style/TGWidget.SeekBar</item>
		<item name="android:listViewStyle">@style/TGWidget.ListView</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== WIDGET STYLES ====================================== -->
	<!-- ========================================================= -->
	<style name="TGWidget" parent="android:Widget" />

	<style name="TGWidget.TextView" >
		<item name="android:typeface">normal</item>
		<item name="android:textStyle">normal</item>
		<item name="android:textSize">18sp</item>
	</style>

	<style name="TGWidget.Spinner" parent="AppBaseWidget.Spinner" />

	<!-- Full-screen transparent host for the menus that grow out of a button -->
	<style name="TGMorphDialog" parent="TGTheme">
		<item name="android:windowIsFloating">false</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimEnabled">false</item>
		<item name="android:windowAnimationStyle">@null</item>
		<item name="windowNoTitle">true</item>
		<item name="windowActionBar">false</item>
	</style>

	<style name="TGWidget.ActionBar" parent="Widget.Material3.ActionBar.Solid">
		<item name="background">?attr/colorSurfaceContainer</item>
		<item name="android:background">?attr/colorSurfaceContainer</item>
		<item name="elevation">0dp</item>
		<item name="android:elevation">0dp</item>
	</style>

	<!-- Slider look: 4dp rounded track, solid 20dp handle. -->
	<style name="TGWidget.SeekBar" parent="Widget.AppCompat.SeekBar">
		<item name="android:progressDrawable">@drawable/tg_seekbar_track</item>
		<item name="android:thumb">@drawable/tg_seekbar_thumb</item>
		<item name="android:thumbTint">@null</item>
		<item name="android:progressTint">@null</item>
		<item name="android:progressBackgroundTint">@null</item>
		<item name="android:splitTrack">false</item>
	</style>

	<!-- Lists separate rows with space and tone, not hairlines. -->
	<style name="TGWidget.ListView" parent="Widget.AppCompat.ListView">
		<item name="android:divider">@null</item>
		<item name="android:dividerHeight">0dp</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== IMAGE BUTTON ======================================= -->
	<!-- ========================================================= -->

	<style name="TGImageButton" >
		<item name="android:layout_width">36dp</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:padding">6dip</item>
		<item name="android:background">@drawable/bg_toggle_pill</item>
		<item name="android:tint">@color/tg_content_toggle</item>
	</style>

	<style name="TGImageButton.Save">
		<item name="android:src">@drawable/ic_save_gray_24dp</item>
	</style>

	<style name="TGImageButton.Add" >
		<item name="android:src">@drawable/ic_add_gray_24dp</item>
	</style>

	<style name="TGImageButton.Delete" >
		<item name="android:src">@drawable/ic_delete_gray_24dp</item>
	</style>

	<style name="TGImageButton.Mixer" >
		<item name="android:src">@drawable/ic_volume_up_white_24dp</item>
	</style>

	<style name="TGImageButton.Info" >
		<item name="android:src">@drawable/ic_info_outline_white_24dp</item>
	</style>

	<style name="TGImageButton.Settings" >
		<item name="android:src">@drawable/ic_settings_gray_24dp</item>
	</style>

	<style name="TGImageButton.Play" >
		<item name="android:src">@drawable/ic_play_circle_outline_white_24dp</item>
	</style>

	<style name="TGImageButton.Stop" >
		<item name="android:src">@drawable/ic_pause_circle_outline_white_24dp</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== FLOATING BUTTON ======================================= -->
	<!-- ========================================================= -->

	<style name="TGFloatingButton" />

	<style name="TGFloatingButton.Add">
		<item name="android:src">@drawable/ic_add_white_24dp</item>
	</style>

	<!-- ========================================================= -->
	<style name="dialogStyle" >
		<item name="android:padding">10dp</item>
	</style>

	<style name="dialogVerticalSpacerStyle" >
		<item name="android:layout_height">20dp</item>
	</style>

	<style name="dialogImageButtonStyle" >
		<item name="android:layout_width">36dp</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:padding">6dip</item>
		<item name="android:background">@drawable/bg_toggle_pill</item>
		<item name="android:tint">@color/tg_content_toggle</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== MAIN =============================================== -->
	<!-- ========================================================= -->

	<style name="mainImageButtonStyle" >
		<item name="android:layout_width">36dp</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:padding">6dip</item>
		<item name="android:background">@drawable/bg_toggle_pill</item>
		<item name="android:tint">@color/tg_content_toggle</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== TAB KEYBOARD ======================================= -->
	<!-- ========================================================= -->

	<style name="tabKeyBoardStyle" >
		<item name="android:background">@drawable/bg_keyboard</item>
	</style>

	<style name="TGKeyBoardButton" >
		<item name="android:typeface">normal</item>
		<item name="android:textStyle">normal</item>
		<item name="android:textSize">18sp</item>
		<item name="android:textColor">?attr/textLightColorSelector</item>

		<item name="android:layout_width">36dp</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:padding">0sp</item>
		<!-- Function keys: tonal. Digits and the select key override below. -->
		<item name="android:background">@drawable/bg_key_function</item>
		<item name="android:tint">?attr/colorOnSecondaryContainer</item>
	</style>

	<style name="TGKeyBoardButton.Digit" >
		<item name="android:background">@drawable/bg_key</item>
		<item name="android:tint">?attr/colorOnSurface</item>
	</style>

	<style name="TGKeyBoardButton.Key0" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_0_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key1" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_1_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key2" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_2_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key3" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_3_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key4" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_4_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key5" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_5_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key6" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_6_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key7" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_7_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key8" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_8_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Key9" parent="TGKeyBoardButton.Digit" >
		<item name="android:src">@drawable/ic_keyboard_key_9_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.AddNote" >
		<item name="android:src">@drawable/ic_add_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Insert" >
		<item name="android:src">@drawable/ic_keyboard_arrow_right_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Delete" >
		<item name="android:src">@drawable/ic_keyboard_arrow_left_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Duration" >
		<item name="android:src">@drawable/ic_music_note_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.DurationIncrement" >
		<item name="android:src">@drawable/ic_keyboard_arrow_up_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.DurationDecrement" >
		<item name="android:src">@drawable/ic_keyboard_arrow_down_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Right" >
		<item name="android:src">@drawable/ic_keyboard_arrow_right_gray_24dp</item>
