		<item name="android:src">@drawable/ic_keyboard_arrow_up_gray_24dp</item>
	</style>

	<style name="TGKeyBoardButton.Down" >
		<item name="android:src">@drawable/ic_keyboard_arrow_down_gray_24dp</item>
	</style>

	<!-- Sheet tile: a small card with an icon over a label; primary pill when active. -->
	<style name="TGQuickSheetTile">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_weight">1</item>
		<item name="android:layout_height">56dp</item>
		<item name="android:layout_margin">4dp</item>
		<item name="android:gravity">center</item>
		<item name="android:orientation">vertical</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
		<item name="android:background">@drawable/bg_tile</item>
	</style>

	<style name="TGQuickSheetTileIcon">
		<item name="android:layout_width">22dp</item>
		<item name="android:layout_height">22dp</item>
		<item name="android:duplicateParentState">true</item>
		<item name="android:importantForAccessibility">no</item>
		<item name="android:tint">@color/tg_tile_content</item>
	</style>

	<style name="TGQuickSheetTileLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:duplicateParentState">true</item>
		<item name="android:maxLines">1</item>
		<item name="android:ellipsize">end</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textSize">11sp</item>
		<item name="android:textColor">@color/tg_tile_content</item>
	</style>

	<style name="TGQuickSheetButton" parent="TGImageButton"/>

	<!-- Round tonal containers for the two top-bar buttons -->
	<style name="TGWidget.ActionButton" parent="Widget.AppCompat.ActionButton">
		<item name="android:background">@drawable/bg_icon_circle</item>
	</style>

	<style name="TGWidget.NavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation">
		<item name="android:background">@drawable/bg_icon_circle</item>
	</style>

	<style name="TGQuickSheetButton.Metronome">
		<item name="android:src">@drawable/ic_metronome_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.CountIn">
		<item name="android:src">@drawable/ic_count_in_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.Keyboard">
		<item name="android:src">@drawable/ic_edit_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.Tracks">
		<item name="android:src">@drawable/ic_music_note_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.Mixer">
		<item name="android:src">@drawable/ic_volume_up_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.Loop">
		<item name="android:src">@drawable/ic_tile_loop</item>
	</style>

	<style name="TGQuickSheetButton.Transpose">
		<item name="android:src">@drawable/ic_transpose_white_24dp</item>
	</style>

	<style name="TGQuickSheetButton.More">
		<item name="android:src">@drawable/ic_more_white_24dp</item>
	</style>

	<style name="TGQuickSheetMenuButton" parent="Widget.Material3.Button.TextButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:minHeight">0dp</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:gravity">start|center_vertical</item>
		<item name="android:paddingLeft">16dp</item>
		<item name="android:paddingRight">16dp</item>
		<item name="android:paddingStart">16dp</item>
		<item name="android:paddingEnd">16dp</item>
		<item name="android:paddingTop">0dp</item>
		<item name="android:paddingBottom">0dp</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textColor">?attr/textLightColorSelector</item>
	</style>

	<!-- Transpose stepper (- / +) and the "apply" action. -->
	<style name="TGQuickSheetTonalButton" parent="Widget.Material3.Button.TonalButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:minHeight">0dp</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:gravity">center</item>
		<item name="android:paddingLeft">0dp</item>
		<item name="android:paddingRight">0dp</item>
		<item name="android:paddingStart">0dp</item>
		<item name="android:paddingEnd">0dp</item>
		<item name="android:paddingTop">0dp</item>
		<item name="android:paddingBottom">0dp</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="TGQuickSheetFilledButton" parent="Widget.Material3.Button">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">36dp</item>
		<item name="android:minHeight">0dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:paddingTop">0dp</item>
		<item name="android:paddingBottom">0dp</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<!-- Section label inside the quick sheet. -->
	<style name="TGQuickSheetLabel">
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:fontFamily">sans-serif-medium</item>
		<item name="android:textStyle">bold</item>
		<item name="android:letterSpacing">0.01</item>
	</style>

	<style name="TGKeyBoardButton.Select" >
		<item name="android:src">@drawable/ic_keyboard_select_gray_24dp</item>
		<item name="android:background">@drawable/bg_key_accent</item>
		<item name="android:tint">?attr/colorOnPrimaryContainer</item>
	</style>

	<!-- ========================================================= -->
	<!-- ==== DRAWER ============================================= -->
	<!-- ========================================================= -->

	<style name="mainDrawerStyle" >
		<item name="android:background">@android:color/transparent</item>
	</style>

	<style name="mainDrawerListItemStyle" >
		<item name="android:layout_width">fill_parent</item>
		<item name="android:layout_height">wrap_content</item>
